<UserControl x:Class="RTFreedom.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:RTFreedom.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
             d:DesignHeight="750" d:DesignWidth="850">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,36" MaxWidth="780" HorizontalAlignment="Left">

            <!-- APP BRANDING HEADER -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Border Width="64" Height="64"
                        CornerRadius="16"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource PrimaryAccentBrush}"
                        BorderThickness="2"
                        Margin="0,0,20,0">
                    <Path Data="{StaticResource IconRayTracingGeometry}"
                          Fill="{StaticResource PrimaryAccentBrush}"
                          Width="32" Height="32"
                          Stretch="Uniform" />
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AppName}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <Border Background="{StaticResource CardBgBrush}"
                                CornerRadius="4"
                                Padding="8,2"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersion}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Next-Gen Ray Tracing Dependency Analyzer &amp; Fallback Utility"
                               FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- ABOUT DESCRIPTION CARD -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="About RT Freedom" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               LineHeight="20"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- CORE PRINCIPLES -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Core Architectural Principles" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding CorePrinciples}"
                               FontSize="13"
                               Foreground="{StaticResource TextBrush}"
                               LineHeight="22"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- LIMITATIONS & HONEST REPORTING DISCLAIMER -->
            <Border CornerRadius="8"
                    Padding="18"
                    Margin="0,0,0,20"
                    Background="#2B1D12"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Data="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"
                              Fill="{StaticResource WarningBrush}"
                              Width="18" Height="18"
                              Stretch="Uniform"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock Text="Honest Reporting &amp; Hardware Limitations"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}" />
                    </StackPanel>

                    <TextBlock Text="Not all games with mandatory ray tracing can be bypassed. When a game engine has completely eliminated rasterized fallback paths (such as pure path-traced engines like Metro Exodus Enhanced Edition or Indiana Jones' mandatory pipeline), hardware RT is an intrinsic architectural requirement. In such cases, attempting to stub DXR calls will cause black screens, missing geometry, or engine crashes. RT Freedom will always transparently indicate Incompatible status."
                               FontSize="12"
                               Foreground="{StaticResource TextBrush}"
                               LineHeight="18"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ANTI-CHEAT GUARANTEE -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Anti-Cheat &amp; Multiplayer Safety" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="RT Freedom strictly operates on configuration files, user shader cache options, and local single-player pipeline hooks. We never modify Easy Anti-Cheat (EAC), BattlEye, Ricochet, or Vanguard binaries. Do not use custom DirectX proxies with protected competitive multiplayer games."
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               LineHeight="20"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- LINKS & REPOSITORY -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Open Source Project" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Contribute adapters, file bug reports, or view release notes on GitHub."
                                   FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Visit GitHub"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenGitHubCommand}"
                            Padding="18,8" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
