<UserControl x:Class="RTFreedom.App.Views.GameLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:RTFreedom.App.ViewModels"
             xmlns:converters="clr-namespace:RTFreedom.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:GameLibraryViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: Header & Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Game Library" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Analyze and bypass mandatory ray-tracing dependencies on detected games"
                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Search, Refresh, Add Game Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Box -->
                <Grid Width="220" Margin="0,0,12,0">
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="30,8,10,8"
                             VerticalContentAlignment="Center" />
                    <!-- Search Icon -->
                    <Path Data="{StaticResource IconSearchGeometry}"
                          Fill="{StaticResource SecondaryTextBrush}"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          HorizontalAlignment="Left"
                          Margin="10,0,0,0"
                          IsHitTestVisible="False" />
                    <!-- Search Placeholder -->
                    <TextBlock Text="Filter games..."
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               Margin="32,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilterText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Refresh Button -->
                <Button Command="{Binding RefreshGamesCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0"
                        ToolTip="Scan directories for newly installed games">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefreshGeometry}"
                              Fill="{StaticResource TextBrush}"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Scan / Refresh" Foreground="{StaticResource TextBrush}" />
                    </StackPanel>
                </Button>

                <!-- Add Game Manually -->
                <Button Command="{Binding AddGameManuallyCommand}"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="Select an executable to add custom game">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlusGeometry}"
                              Fill="#0A0E1A"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,6,0" />
                        <TextBlock Text="Add Game" Foreground="#0A0E1A" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- MAIN BODY: Game Cards Grid -->
        <ScrollViewer Grid.Row="1" Focusable="False">
            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                        <!-- Game Card with Hover Glow and Scale Effect -->
                        <Border Width="260"
                                Height="220"
                                Margin="0,0,20,20"
                                CornerRadius="10"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Effect="{StaticResource CardShadow}"
                                Cursor="Hand">
                            <!-- Card Content -->
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenGameDetailCommand}" />
                            </Border.InputBindings>

                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CardHoverBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}" />
                                            <Setter Property="Effect" Value="{StaticResource GlowCyan}" />
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.02" ScaleY="1.02" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid Margin="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Card Top Row: Platform Badge and Patched Indicator -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Platform Pill -->
                                    <Border Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PlatformBadgeShort}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryAccentBrush}"
                                                       Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding PlatformText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Patched Pill Indicator -->
                                    <Border Grid.Column="1"
                                            Background="#143D2A"
                                            BorderBrush="{StaticResource SuccessBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Visibility="{Binding IsPatched, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="PATCHED"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource SuccessBrush}" />
                                    </Border>
                                </Grid>

                                <!-- Card Center: Title & Engine / Publisher Info -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}"
                                               TextWrapping="Wrap"
                                               MaxHeight="48"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Text="{Binding Game.Publisher}"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Text="{Binding Game.GraphicsApi}"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Card Bottom: Compatibility Status Badge -->
                                <Border Grid.Row="2"
                                        Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource BorderBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Color Dot -->
                                        <Ellipse Grid.Column="0"
                                                 Width="8" Height="8"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="{x:Type Ellipse}">
                                                    <Setter Property="Fill" Value="{Binding CompatibilityColor}" />
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StatusText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- EMPTY STATE MESSAGE -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding HasNoGames, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="{StaticResource IconLibraryGeometry}"
                      Fill="{StaticResource SecondaryTextBrush}"
                      Width="48" Height="48"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,16" />
                <TextBlock Text="No games found"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Click 'Scan / Refresh' to search for Steam, Epic, or Xbox games, or click 'Add Game' to add a custom executable."
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,8,0,20"
                           TextAlignment="Center"
                           MaxWidth="380"
                           TextWrapping="Wrap" />
                <Button Command="{Binding RefreshGamesCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center"
                        Content="Scan for Games" />
            </StackPanel>
        </Border>

        <!-- SCANNING LOADING OVERLAY -->
        <Border Grid.Row="1"
                Background="#B310162A"
                CornerRadius="12"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="240"
                             Height="6"
                             Foreground="{StaticResource PrimaryAccentBrush}"
                             Background="{StaticResource SurfaceBrush}"
                             Margin="0,0,0,16" />
                <TextBlock Text="Scanning platform game libraries..."
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Inspecting Steam manifests, Epic manifests, and Xbox packages..."
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
