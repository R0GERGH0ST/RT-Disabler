<Window x:Class="RTFreedom.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RTFreedom.App.ViewModels"
        xmlns:views="clr-namespace:RTFreedom.App.Views"
        xmlns:converters="clr-namespace:RTFreedom.App.Converters"
        mc:Ignorable="d"
        Title="RT Freedom - Ray Tracing Dependency Analyzer"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />

        <!-- View DataTemplates -->
        <DataTemplate DataType="{x:Type vm:GameLibraryViewModel}">
            <views:GameLibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameDetailViewModel}">
            <views:GameDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Custom Title Bar -->
                <RowDefinition Height="38" />
                <!-- Row 1: Main Application Body (Sidebar + Content) -->
                <RowDefinition Height="*" />
                <!-- Row 2: Status Bar -->
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- ========================================================================= -->
            <!-- ROW 0: CUSTOM TITLE BAR                                                   -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="0"
                  Background="{StaticResource SurfaceBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Icon & Title -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">
                    <Path Data="{StaticResource IconRayTracingGeometry}"
                          Fill="{StaticResource PrimaryAccentBrush}"
                          Width="16" Height="16"
                          Stretch="Uniform"
                          Margin="0,0,10,0" />

                    <TextBlock Text="RT FREEDOM"
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" />

                    <Border Background="{StaticResource CardBgBrush}"
                            CornerRadius="3"
                            Padding="6,2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="RT ANALYZER"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryAccentBrush}" />
                    </Border>
                </StackPanel>

                <!-- Window Control Buttons (Min, Max, Close) -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Minimize -->
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize">
                        <Path Data="M19,13H5V11H19V13Z"
                              Fill="{StaticResource TextBrush}"
                              Width="10" Height="10"
                              Stretch="Uniform" />
                    </Button>

                    <!-- Maximize / Restore -->
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Click="MaximizeButton_Click"
                            ToolTip="Maximize">
                        <Path Data="M4,4H20V20H4V4M6,6V18H18V6H6Z"
                              Fill="{StaticResource TextBrush}"
                              Width="10" Height="10"
                              Stretch="Uniform" />
                    </Button>

                    <!-- Close -->
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="{StaticResource TextBrush}"
                              Width="10" Height="10"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ========================================================================= -->
            <!-- ROW 1: MAIN BODY (SIDEBAR + MAIN CONTENT PRESENTER)                       -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Left Sidebar Navigation -->
                    <ColumnDefinition Width="220" />
                    <!-- Content View Area -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Navigation Items -->
                        <StackPanel Grid.Row="0" Margin="8,16,8,0">
                            <!-- Library Nav Button -->
                            <Button Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding NavigateToLibraryCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconLibraryGeometry}"
                                          Fill="{StaticResource PrimaryAccentBrush}"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          Margin="0,0,14,0" />
                                    <TextBlock Text="Library" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <!-- Settings Nav Button -->
                            <Button Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding NavigateToSettingsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSettingsGeometry}"
                                          Fill="{StaticResource SecondaryAccentBrush}"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          Margin="0,0,14,0" />
                                    <TextBlock Text="Settings" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <!-- About Nav Button -->
                            <Button Style="{StaticResource NavButtonStyle}"
                                    Command="{Binding NavigateToAboutCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconAboutGeometry}"
                                          Fill="{StaticResource SecondaryTextBrush}"
                                          Width="16" Height="16"
                                          Stretch="Uniform"
                                          Margin="0,0,14,0" />
                                    <TextBlock Text="About &amp; Info" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Sidebar Footer Badge -->
                        <Border Grid.Row="2"
                                Background="{StaticResource BackgroundBrush}"
                                CornerRadius="6"
                                Margin="12"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="Safe Mode Active"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="Full backups before modification"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- MAIN CONTENT AREA -->
                <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                    <ContentPresenter Content="{Binding CurrentView}" />
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- ROW 2: STATUS BAR                                                         -->
            <!-- ========================================================================= -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,0,8,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- GPU Hardware info -->
                        <ColumnDefinition Width="*" />
                        <!-- Ray Tracing indicator -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: GPU Name, Driver, VRAM -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- GPU Icon -->
                        <Path Data="M4,6H20V16H4M20,18A2,2 0 0,0 22,16V6C22,4.89 21.1,4 20,4H4C2.89,4 2,4.89 2,6V16A2,2 0 0,0 4,18H0V20H24V18H20Z"
                              Fill="{StaticResource PrimaryAccentBrush}"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />

                        <TextBlock Text="{Binding GpuName}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" />

                        <TextBlock Text=" • " Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />

                        <TextBlock Text="{Binding GpuDriverVersion}"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />

                        <TextBlock Text=" • " Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />

                        <TextBlock Text="{Binding GpuVramText}"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: RT Support dot indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Indicator Circle -->
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="{x:Type Ellipse}">
                                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRtSupported}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock Text="{Binding RtSupportText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
